POSTGRES_DB=person_website
POSTGRES_USER=person_website
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://person_website:change-me@postgres:5432/person_website

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_test_...
CLERK_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_SITE_URL=http://YOUR_ECS_PUBLIC_IP

# Optional. Use only when connecting to an external PostgreSQL service that requires SSL.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
